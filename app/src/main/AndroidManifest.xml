<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Necessária no Android 13+ para mostrar as notificações de
         progresso e de "processo concluído". -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Permitem que a conversão rode num serviço em primeiro plano, para
         que o usuário possa sair do app enquanto ela continua. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/ic_menu_save"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.XisoConverter"
        android:largeHeap="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Serviço em primeiro plano que faz o empacotamento/extração de
             verdade, para que o processo continue mesmo se o usuário sair
             do app. Mostra uma notificação de progresso enquanto roda e
             uma notificação final de "concluído" (ou cancelado/erro). -->
        <service
            android:name=".ConversionService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>
